# OpenAI credentials used by the provider adapters.
OPENAI_API_KEY=replace-me

# Comma-separated tenant=key pairs. Use a secrets manager outside local development.
KA_TENANT_API_KEYS=demo=replace-with-a-long-random-secret,acme=another-random-secret

# Optional overrides.
KA_DATABASE_PATH=data/knowledge.db
KA_CHAT_MODEL=gpt-4.1-mini
KA_EMBEDDING_MODEL=text-embedding-3-small
KA_EMBEDDING_BATCH_SIZE=256
KA_EMBEDDING_BATCH_MAX_TOKENS=250000

# Stateless by default. Enable only when response retrieval is an explicit policy choice.
KA_OPENAI_STORE_RESPONSES=false
